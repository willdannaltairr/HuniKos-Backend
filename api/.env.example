# Port server
PORT=3000
NODE_ENV=development

# Koneksi database (URI dari Aiven, TANPA parameter ?sslmode=...)
DATABASE_URL=postgres://user:password@host:port/defaultdb

# Isi file ca.pem dari Aiven. Boleh ditulis dalam satu baris memakai \n.
DB_CA_CERT=

# Free plan Aiven membatasi 20 koneksi
DB_POOL_MAX=5

# Minimal 32 karakter acak
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Daftar origin dipisah koma (domain Vercel + localhost)
CORS_ORIGINS=http://localhost:3000

# URL publik backend, dipakai membentuk image_url driver local
BASE_URL=http://localhost:3000

# local atau cloudinary (produksi wajib cloudinary)
STORAGE_DRIVER=local

# Hanya diisi bila STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
