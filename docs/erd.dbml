// ERD HUNIKOS untuk dbdiagram.io — tempel seluruh isi file ini ke panel kiri.

Table users {
  id uuid [pk]
  full_name varchar(100) [not null]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  phone_number varchar(20)
  avatar_url text
  role varchar(10) [not null, note: 'tenant | owner | admin']
  account_status varchar(10) [not null, default: 'active', note: 'active | suspended']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table properties {
  id uuid [pk]
  owner_id uuid [not null, ref: > users.id]
  name varchar(120) [not null]
  description text
  address text [not null]
  city varchar(80) [not null]
  latitude numeric(9,6)
  longitude numeric(9,6)
  property_type varchar(10) [not null, note: 'putra | putri | campur']
  rules text
  verification_status varchar(10) [not null, default: 'pending', note: 'pending | approved | rejected']
  rejection_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table rooms {
  id uuid [pk]
  property_id uuid [not null, ref: > properties.id]
  room_number varchar(20) [not null]
  room_type varchar(50) [not null, default: 'standard']
  dimensions varchar(20)
  monthly_price numeric(14,2) [not null]
  max_occupants smallint [not null, default: 1]
  bathroom_type varchar(10) [not null, note: 'dalam | luar']
  floor_number smallint [not null, default: 1]
  status varchar(12) [not null, default: 'AVAILABLE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (property_id, room_number) [unique]
  }
}

Table facilities {
  id uuid [pk]
  name varchar(60) [not null, unique]
}

Table room_facilities {
  room_id uuid [not null, ref: > rooms.id]
  facility_id uuid [not null, ref: > facilities.id]

  indexes {
    (room_id, facility_id) [pk]
  }
}

Table property_images {
  id uuid [pk]
  property_id uuid [not null, ref: > properties.id]
  room_id uuid [ref: > rooms.id]
  image_url text [not null]
  storage_key text [not null]
  is_cover boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table bookings {
  id uuid [pk]
  booking_code varchar(20) [not null, unique]
  tenant_id uuid [not null, ref: > users.id]
  room_id uuid [not null, ref: > rooms.id]
  start_date date [not null]
  duration_months smallint [not null]
  end_date date [not null, note: 'eksklusif']
  rental_price_snapshot numeric(14,2) [not null]
  total_amount numeric(14,2) [not null]
  status varchar(20) [not null, default: 'PENDING']
  note text
  owner_note text
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table booking_status_histories {
  id uuid [pk]
  booking_id uuid [not null, ref: > bookings.id]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_by uuid [ref: > users.id, note: 'NULL berarti sistem']
  note text
  created_at timestamptz [not null, default: `now()`]
}

Table payments {
  id uuid [pk]
  booking_id uuid [not null, ref: > bookings.id]
  amount numeric(14,2) [not null]
  proof_url text [not null]
  storage_key text [not null]
  status varchar(10) [not null, default: 'PENDING', note: 'PENDING | VERIFIED | REJECTED']
  verified_by uuid [ref: > users.id]
  verified_at timestamptz
  note text
  created_at timestamptz [not null, default: `now()`]
}

Table maintenance_requests {
  id uuid [pk]
  booking_id uuid [not null, ref: > bookings.id]
  room_id uuid [not null, ref: > rooms.id]
  tenant_id uuid [not null, ref: > users.id]
  title varchar(120) [not null]
  description text [not null]
  photo_url text
  storage_key text
  status varchar(12) [not null, default: 'OPEN', note: 'OPEN | IN_PROGRESS | DONE']
  owner_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
