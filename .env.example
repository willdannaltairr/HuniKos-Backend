# Port server
PORT=3000
NODE_ENV=development

# Koneksi database (URI dari Aiven, TANPA parameter ?sslmode=...)
DATABASE_URL=postgres://user:password@host:port/defaultdb

# Sertifikat CA Aiven. Pilih salah satu:
# - DB_CA_CERT: isi sertifikatnya langsung (boleh satu baris dengan \n)
# - DB_CA_CERT_PATH: path ke berkas .pem, mis. certs/aiven-ca.pem
DB_CA_CERT=
DB_CA_CERT_PATH=

# Free plan Aiven membatasi 20 koneksi
DB_POOL_MAX=5

# Minimal 32 karakter acak
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Daftar origin dipisah koma (domain website + localhost)
CORS_ORIGINS=http://localhost:3000

# Batas percobaan login per IP per 15 menit (default 10)
LOGIN_RATE_LIMIT=10

# Penyimpanan gambar: Cloudinary (wajib, karena file tidak disimpan di disk server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
